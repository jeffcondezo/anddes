# =============================================================================
# GISTM — variables de entorno / referencia para Azure Key Vault
# En Key Vault usar el mismo nombre cambiando _ por - (ej. DJANGO_SECRET_KEY -> DJANGO-SECRET-KEY)
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Hosts permitidos (coma). Fase actual: IP del VPS. Luego: dominio(s).
# Ej temporal: 203.0.113.10,localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=
# Orígenes CSRF con esquema. Fase actual HTTP+IP; luego https://tudominio.com
# Ej temporal: http://203.0.113.10,http://localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
# Seguridad HTTP (solo aplica con DJANGO_DEBUG=False):
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_PROXY_SSL=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=False
# Forzar CSP en desarrollo: DJANGO_CSP_ENABLED=True

# --- PostgreSQL (VPS) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
# En el mismo servidor: 127.0.0.1 (no dejar vacío)
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Microsoft Entra ID (login SSO) ---
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
# Fase actual (sin dominio/SSL): http://<IP>/auth/callback/
# Con dominio+TLS: https://tudominio.com/auth/callback/
AZURE_AD_REDIRECT_URI=http://IP-DEL-SERVIDOR/auth/callback/
AZURE_AD_REQUIRE_LOGIN=True

# --- Azure Blob Storage (evidencias / PDFs) ---
# Obligatorio: todos los archivos se guardan en Blob (no hay disco local en runtime).
# La connection string DEBE incluir AccountKey (no solo SharedAccessSignature de cuenta).
# Las URLs de descarga se firman por blob, solo lectura, con caducidad corta.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
# Segundos de validez del SAS de lectura por archivo (default 900 = 15 min).
# AZURE_STORAGE_URL_EXPIRE_SECS=900

# --- Correo: solo Azure Communication Services (Email) ---
# Connection string del recurso Communication Services (portal Azure). Obligatorio para enviar.
AZURE_COMMUNICATION_CONNECTION_STRING=
# Remitente autorizado en el dominio verificado de ACS (ej. DoNotReply@dominio.com)
AZURE_COMMUNICATION_SENDER_ADDRESS=
# Dominio de envio verificado en ACS (opcional, documentacion)
AZURE_COMMUNICATION_EMAIL_DOMAIN=
# Remitente que usa la aplicacion (debe coincidir con SENDER_ADDRESS autorizado en ACS)
DEFAULT_FROM_EMAIL=

# Avisos de actividades (cron procesar_actividades_diarias): dias antes del vencimiento.
# 1 = manana, 0 = dia del vencimiento. Separados por coma.
ACTIVIDAD_AVISO_DIAS_ANTES=1,0
#
# Cron diario (python3.13 del sistema, sin venv). Ver deploy/cron.example
#   0 12 * * * cd /var/www/html/anddes/gistm && /usr/bin/python3.13 manage.py procesar_actividades_diarias >> /var/log/gistm-cron.log 2>&1
